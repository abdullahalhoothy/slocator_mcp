sequenceDiagram
    participant Tool
    participant SM as SessionManager
    participant Disk as File System

    Tool->>SM: get_current_session()
    SM->>Disk: scan sessions/ directory
    alt session file found
        Disk-->>SM: session_metadata.json
        SM->>SM: check expiry
        alt not expired
            SM-->>Tool: SessionInfo object
        else expired
            SM->>Disk: delete session directory
            SM-->>Tool: None
        end
    else no session
        SM-->>Tool: None
    end

    Tool->>SM: create_session()
    SM->>SM: generate UUID session_id
    SM->>SM: set expires_at = now + TTL
    SM->>Disk: mkdir sessions/session_id/
    SM->>Disk: write session_metadata.json
    SM-->>Tool: SessionInfo

    Tool->>SM: update_session_auth(id_token, refresh_token)
    SM->>Disk: rewrite session_metadata.json
    SM-->>Tool: updated SessionInfo